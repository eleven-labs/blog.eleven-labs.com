{
  "name": "blog-eleven-labs",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "prepare": "pnpm build:design-system && pnpm ts-node bin/prepare",
    "build:design-system": "pnpm optimize:svgs && pnpm build:icons",
    "optimize:svgs": "svgo --config svgo.config.cjs -f src/design-system/assets/svgs -o ./public/svgs",
    "build:icons": "svgr --config-file svgr.config.cjs --typescript -d src/design-system/ui/icon/svgs public/svgs",
    "postinstall": "sh -c 'git rev-parse --is-inside-work-tree >/dev/null 2>&1 && husky || true'",
    "ts-node": "tsx --import ./bin/loaders/registerStyleStub.mjs -r dotenv/config",
    "generate-image-formats": "pnpm ts-node bin/generateImageFormats",
    "validate-markdown": "pnpm ts-node bin/validateMarkdown",
    "indexation:algolia": "pnpm ts-node bin/indexationAlgolia",
    "build": "pnpm ts-node bin/build",
    "prerender": "pnpm build && pnpm ts-node bin/prerender",
    "start:dev": "pnpm ts-node bin/dev",
    "start:prod": "NODE_ENV=production node dist/server",
    "start:static": "npx serv --path dist/public",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:stories": "vitest run --project stories",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"bin/**/*.ts\"",
    "lint:style": "stylelint 'src/**/*.css'",
    "type-check": "pnpm exec tsc --noEmit",
    "test": "vitest run --project unit --coverage"
  },
  "lint-staged": {
    "*.(ts|tsx)": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">= 20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@remix-run/router": "^1.16.0",
    "algoliasearch": "^4.23.3",
    "autosuggest-highlight": "^3.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^3.3.3",
    "cross-fetch": "^4.0.0",
    "date-fns": "^3.6.0",
    "downshift": "^9.0.4",
    "express": "^4.19.2",
    "glob": "^10.3.12",
    "hoofd": "^1.7.1",
    "i18next": "^23.11.3",
    "i18next-browser-languagedetector": "^7.2.1",
    "i18next-http-middleware": "^3.5.0",
    "lucide-react": "1.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.1",
    "react-router": "6.30.3",
    "react-router-dom": "^6.23.0",
    "react-share": "^5.1.0",
    "react-syntax-highlighter": "^15.5.0",
    "refractor": "^3.6.0",
    "serve-static": "^1.15.0",
    "tailwind-merge": "^3.7.0",
    "universal-cookie-express": "^7.1.4",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@eslint/js": "^10.0.0",
    "@mdx-js/mdx": "^2.3.0",
    "@rollup/plugin-replace": "^5.0.5",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@svgr/cli": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.6",
    "@types/autosuggest-highlight": "^3.2.0",
    "@types/express": "^4.17.21",
    "@types/gtag.js": "^0.0.19",
    "@types/i18next": "^13.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.1",
    "@types/node": "^20.12.8",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/react-i18next": "^8.1.0",
    "@types/react-syntax-highlighter": "^15.5.7",
    "@types/sanitize-html": "^2.11.0",
    "@types/serve-static": "^2.2.0",
    "@types/unist": "^3.0.0",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
